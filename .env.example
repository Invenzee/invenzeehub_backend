PORT=5000
NODE_ENV=development

# Preferred on Windows when mongodb+srv DNS fails (querySrv ECONNREFUSED):
# Copy the "Standard connection string" from Atlas → Connect → Drivers.
# Atlas standard URI — use ALL 3 hosts + replicaSet. Do NOT use directConnection=true (causes "not primary" on writes).
# MONGODB_URI=mongodb://<user>:<password>@ac-xxx-shard-00-00.example.mongodb.net:27017,ac-xxx-shard-00-01.example.mongodb.net:27017,ac-xxx-shard-00-02.example.mongodb.net:27017/invenzeehub?ssl=true&replicaSet=atlas-xxx-shard-0&authSource=admin&retryWrites=true&w=majority

# SRV format (works when DNS resolves SRV records):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/invenzeehub?retryWrites=true&w=majority

MONGODB_URI=mongodb://127.0.0.1:27017/invenzeehub

# Auth (required for /api/auth/*)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_MS=604800000

# Testing: mute Resend + Cloudinary (true = no external calls)
MUTE_EXTERNAL=true

# Email OTP via Resend (ignored while MUTE_EXTERNAL=true or RESEND_API_KEY empty)
RESEND_API_KEY=
EMAIL_FROM=InvenzeeHub <onboarding@your-verified-domain.com>
APP_NAME=InvenzeeHub
LOGIN_CODE_EXPIRES_MINUTES=10
LOGIN_CODE_COOLDOWN_SECONDS=60
LOGIN_CODE_MAX_ATTEMPTS=5

# One-time bootstrap of first super_admin (POST /api/users/bootstrap)
BOOTSTRAP_SECRET=change-me-bootstrap-secret

# Frontend origin(s) for CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Cloudinary (ignored while MUTE_EXTERNAL=true or keys empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=invenzeehub/avatars

# Groq Whisper — free voice "Generate transcript" (https://console.groq.com/)
GROQ_API_KEY=
